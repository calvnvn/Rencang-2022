# Salin file ini menjadi .env, lalu jalankan: php artisan key:generate
# Nilai di bawah memakai pengaturan produksi yang aman (debug mati).
# Untuk pengembangan lokal, ubah APP_ENV=local dan APP_DEBUG=true agar pesan
# error tampil lengkap.

APP_NAME=Rencang
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rencang.umn.ac.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Website ini tidak memakai database. Jangan ubah driver di bawah
# menjadi "database" kecuali database memang sudah disiapkan IT.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
